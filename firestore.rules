rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helpers
    function isSignedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Registered users: owners or admins only
    match /registeredUsers/{userId} {
      // Allow creating your own profile when signed in and uid matches
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.email is string
        && request.resource.data.courses is list;

      // Users can read/update their own profile; admins can read/update/delete
      allow read, update, delete: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    // Coupons: readable by signed-in users; creation/deletion only by admins.
    // Updates: admins may edit freely. A user may redeem a coupon only if:
    // - coupon was unused (resource.data.used == false)
    // - request sets used -> true and redeemedBy == request.auth.uid
    // - redeemedAt is set to server time (request.time)
    match /coupons/{couponId} {
      allow read: if isSignedIn();
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (
          isSignedIn()
          && resource.data.used == false
          && request.resource.data.used == true
          && request.resource.data.redeemedBy == request.auth.uid
          // redeemedAt must be server timestamp (equal to request.time)
          && request.resource.data.redeemedAt == request.time
          // Prevent arbitrary changes to other coupon fields on user redeem
          && request.resource.data.expiresAt == resource.data.expiresAt
          && request.resource.data.code == resource.data.code
        );
    }

    // Questions: readable by signed-in users; only admins can create/update/delete.
    // IMPORTANT: consider storing correct answers in a restricted subcollection or
    // returning them via a Cloud Function so clients cannot read correct answers directly.
    match /questions/{questionId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // Courses: accessible to signed-in users; admins manage
    match /courses/{courseId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // Exam results: users can create their own result documents; reads limited to owner or admin.
    match /examResults/{resultId} {
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        // completedAt must be server timestamp
        && request.resource.data.completedAt == request.time
        // basic sanity checks
        && request.resource.data.score is int
        && request.resource.data.totalQuestions is int;

      allow read, update, delete: if isSignedIn() && (request.auth.uid == resource.data.userId || isAdmin());
    }

    // Admin-only area: any other admin collections should be protected explicitly
    match /admin/{doc=**} {
      allow read, write: if isAdmin();
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
